# ── Server ────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# ── Database (PostgreSQL) ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123
DB_DATABASE=allie-shop
DB_SSL=false

# ── Authentication ─────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_change_in_production
# Short-lived access token (httpOnly auth_token cookie)
ACCESS_TOKEN_EXPIRES_IN=15m
# Refresh session length (httpOnly refresh_token cookie) — single use, rotated
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_REMEMBER_EXPIRES_IN=30d

# ── Web Push (optional) ────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# Leave blank to disable push notifications (the API returns 503 and the
# settings UI reports push as unavailable instead of subscribing with a
# key that can never deliver anything).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@example.com