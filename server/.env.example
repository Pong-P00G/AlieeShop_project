# ── Server ────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3001
# Global rate limit: requests allowed per IP per 15-minute window
# (defaults to 1000 when unset)
RATE_LIMIT_MAX=1000

# ── Database (PostgreSQL) ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123
DB_DATABASE=aliee_shop
DB_SSL=false

# ── Authentication ─────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_change_in_production
# Short-lived access token (httpOnly auth_token cookie)
ACCESS_TOKEN_EXPIRES_IN=15m
# Refresh session length (httpOnly refresh_token cookie) — single use, rotated
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_REMEMBER_EXPIRES_IN=30d

# ── Web Push (optional) ────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# Leave blank to disable push notifications (the API returns 503 and the
# settings UI reports push as unavailable instead of subscribing with a
# key that can never deliver anything).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@example.com

# ── Object storage (Cloudflare R2 or any S3-compatible bucket) ────────
# Product images are uploaded here and delivered from R2_PUBLIC_BASE_URL.
# R2_ENDPOINT looks like https://<account-id>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL is the bucket's public origin: an r2.dev URL or a custom
# domain on Cloudflare. Leave these blank to disable uploads (the API answers
# 503 from GET /api/images instead of crashing).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
# Cache-Control sent with every uploaded object. Served through a custom domain,
# the CDN honours it and keeps the image at the edge. Defaults to one year
# because object names are unique and never change.
R2_CACHE_CONTROL=public, max-age=31536000, immutable