{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env ./src/main.js",
    "start": "node --env-file=.env ./src/main.js",
    "start:prod": "node ./src/main.js",
    "setup": "node --env-file=.env setup.js",
    "seed": "node --env-file=.env seed_products.sql",
    "migrate": "node --env-file=.env migrate.js",
    "images:migrate": "node --env-file=.env scripts/migrate-images-to-r2.js",
    "images:cache": "node --env-file=.env scripts/backfill-cache-control.js",
    "images:audit": "node --env-file=.env scripts/audit-images.js",
    "test": "vitest run",
    "test:integration": "node --env-file=.env ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "puppeteer-core": "^23.11.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "dotenv": "^17.2.1",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
